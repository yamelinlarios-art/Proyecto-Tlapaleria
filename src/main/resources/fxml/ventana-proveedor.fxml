<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
   </padding>
   <children>
      <!-- Encabezado con Saldo Total -->
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label text="Directorio de Proveedores" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <!-- Se escapa el signo $ con \$0.00 -->
            <Label fx:id="lblSaldoTotalGeneral" text="SALDO TOTAL PENDIENTE: \$0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: red;" />
         </children>
      </HBox>

      <!-- Tabla de Proveedores -->
      <TableView fx:id="tablaProveedores" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
          <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="200.0" />
          <TableColumn fx:id="colContactoPersonal" text="Contacto Personal" prefWidth="150.0" />
          <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="130.0" />
          <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="120.0" />
        </columns>
      </TableView>

      <!-- Botón de acción -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnVerDetalle" text="Ver Detalles" onAction="#handleVerDetalle" disable="true" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" />
         </children>
      </HBox>
   </children>
</VBox>