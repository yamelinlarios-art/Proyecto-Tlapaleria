<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="mx.uam.ayd.proyecto.presentacion.consultarProveedor.ControlProveedor">
   <padding>
      <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label text="Directorio de Proveedores" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblSaldoTotalGeneral" text="SALDO TOTAL PENDIENTE: $0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: red;" />
         </children>
      </HBox>
      <TableView fx:id="tablaProveedores" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
          <TableColumn fx:id="colNombre" text="Proveedor / Corporativo" prefWidth="220.0" />
          <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120.0" />
          <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120.0" />
          <TableColumn fx:id="colSaldo" text="Saldo Pendiente" prefWidth="120.0" />
          <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0" />
        </columns>
      </TableView>
   </children>
</VBox>