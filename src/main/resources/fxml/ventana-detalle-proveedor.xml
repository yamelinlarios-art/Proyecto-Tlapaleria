<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <!-- Datos del Proveedor -->
      <VBox spacing="5.0" style="-fx-background-color: #f4f4f4; -fx-padding: 10; -fx-background-radius: 5;">
         <children>
            <Label fx:id="lblNombreProveedor" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Proveedor: " />
            <Label fx:id="lblContacto" text="Contacto: " />
            <Label fx:id="lblTipo" text="Categoría: " />
            <!-- Se escapó el signo de pesos como \$0.00 -->
            <Label fx:id="lblSaldoTotal" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: red;" text="Saldo Pendiente Total: \$0.00" />
         </children>
      </VBox>

      <!-- Tabla de Facturas -->
      <Label style="-fx-font-weight: bold;" text="Facturas Pendientes:" />
      <TableView fx:id="tablaFacturas" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colIdFactura" prefWidth="80.0" text="ID Factura" />
          <TableColumn fx:id="colMontoTotal" prefWidth="120.0" text="Monto Total" />
          <TableColumn fx:id="colSaldoPendiente" prefWidth="130.0" text="Saldo Pendiente" />
          <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
        </columns>
      </TableView>

      <!-- Botones -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnRegistrarPago" onAction="#handleRegistrarPago" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Registrar Pago" />
            <Button onAction="#handleRegresar" text="Regresar" />
         </children>
      </HBox>
   </children>
</VBox>