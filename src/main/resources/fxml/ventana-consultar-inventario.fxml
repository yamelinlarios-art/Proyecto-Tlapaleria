<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="650.0"
            prefWidth="1050.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="8.0"
              style="-fx-background-color: #263238;">

            <padding>
                <Insets top="18.0"
                        right="25.0"
                        bottom="18.0"
                        left="25.0"/>
            </padding>

            <Label text="Consultar inventario"
                   textFill="WHITE">

                <font>
                    <Font name="Arial Bold"
                          size="26.0"/>
                </font>
            </Label>

            <Label text="Consulta los productos registrados y revisa sus existencias."
                   textFill="#cfd8dc">

                <font>
                    <Font name="Arial"
                          size="14.0"/>
                </font>
            </Label>

        </VBox>
    </top>

    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="22.0"
                        right="25.0"
                        bottom="22.0"
                        left="25.0"/>
            </padding>

            <VBox spacing="10.0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8px;
                         -fx-border-color: #dce1e5;
                         -fx-border-radius: 8px;">

                <padding>
                    <Insets top="15.0"
                            right="15.0"
                            bottom="15.0"
                            left="15.0"/>
                </padding>

                <Label text="Buscar producto"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #263238;"/>

                <HBox spacing="10.0">

                    <TextField fx:id="textFieldNombre"
                               promptText="Escribe el nombre del producto"
                               prefHeight="38.0"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Buscar"
                            onAction="#onBuscarProducto"
                            prefHeight="38.0"
                            prefWidth="110.0"
                            style="-fx-background-color: #1976d2;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5px;"/>

                    <Button text="Mostrar todos"
                            onAction="#onMostrarTodos"
                            prefHeight="38.0"
                            prefWidth="130.0"
                            style="-fx-background-color: #546e7a;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5px;"/>

                </HBox>

            </VBox>

            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8px;
                         -fx-border-color: #dce1e5;
                         -fx-border-radius: 8px;">

                <padding>
                    <Insets top="15.0"
                            right="15.0"
                            bottom="15.0"
                            left="15.0"/>
                </padding>

                <Label text="Productos registrados"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #263238;"/>

                <TableView fx:id="tablaProductos"
                           prefHeight="430.0"
                           VBox.vgrow="ALWAYS">

                    <placeholder>
                        <Label text="No hay productos para mostrar."
                               style="-fx-text-fill: #78909c;"/>
                    </placeholder>

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="60.0"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="190.0"/>

                        <TableColumn fx:id="colTipoProducto"
                                     text="Tipo"
                                     prefWidth="135.0"/>

                        <TableColumn fx:id="colMarca"
                                     text="Marca"
                                     prefWidth="130.0"/>

                        <TableColumn fx:id="colCategoria"
                                     text="Categoría"
                                     prefWidth="145.0"/>

                        <TableColumn fx:id="colPrecio"
                                     text="Precio"
                                     prefWidth="110.0"/>

                        <TableColumn fx:id="colExistencia"
                                     text="Existencia"
                                     prefWidth="110.0"/>

                    </columns>

                </TableView>

            </VBox>

            <HBox alignment="CENTER_RIGHT">

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Regresar"
                        onAction="#onRegresar"
                        prefHeight="38.0"
                        prefWidth="120.0"
                        style="-fx-background-color: #c62828;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 5px;"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>