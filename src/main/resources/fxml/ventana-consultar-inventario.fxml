<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1100.0"
            prefHeight="650.0"
            minWidth="900.0"
            minHeight="550.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="5.0"
              style="-fx-background-color: #263238;">

            <padding>
                <Insets top="22.0"
                        right="30.0"
                        bottom="22.0"
                        left="30.0"/>
            </padding>

            <children>
                <Label text="Consultar inventario"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <Label text="Consulta la información y existencia de los productos registrados."
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #cfd8dc;"/>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="18.0">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <children>

                <VBox spacing="10.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10px;
                             -fx-border-radius: 10px;
                             -fx-border-color: #dfe5e8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                    <padding>
                        <Insets top="18.0"
                                right="20.0"
                                bottom="18.0"
                                left="20.0"/>
                    </padding>

                    <children>

                        <Label text="Buscar producto"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #263238;"/>

                        <HBox spacing="12.0"
                              alignment="CENTER_LEFT">

                            <children>

                                <TextField fx:id="textFieldNombre"
                                           promptText="Escribe el nombre del producto"
                                           prefHeight="40.0"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #f8fafb;
                                                  -fx-border-color: #b0bec5;
                                                  -fx-border-radius: 6px;
                                                  -fx-background-radius: 6px;
                                                  -fx-font-size: 14px;
                                                  -fx-padding: 0 12 0 12;"/>

                                <Button text="Buscar"
                                        onAction="#onBuscarProducto"
                                        prefWidth="125.0"
                                        prefHeight="40.0"
                                        style="-fx-background-color: #1565c0;
                                               -fx-text-fill: white;
                                               -fx-font-size: 14px;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 6px;
                                               -fx-cursor: hand;"/>

                                <Button text="Mostrar todos"
                                        onAction="#onMostrarTodos"
                                        prefWidth="145.0"
                                        prefHeight="40.0"
                                        style="-fx-background-color: #546e7a;
                                               -fx-text-fill: white;
                                               -fx-font-size: 14px;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 6px;
                                               -fx-cursor: hand;"/>

                            </children>
                        </HBox>

                    </children>
                </VBox>

                <VBox spacing="12.0"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10px;
                             -fx-border-radius: 10px;
                             -fx-border-color: #dfe5e8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                    <padding>
                        <Insets top="18.0"
                                right="20.0"
                                bottom="18.0"
                                left="20.0"/>
                    </padding>

                    <children>

                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0">

                            <children>

                                <Label text="Productos registrados"
                                       style="-fx-font-size: 17px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #263238;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label text="Consulta los productos disponibles"
                                       style="-fx-font-size: 12px;
                                              -fx-text-fill: #78909c;"/>

                            </children>
                        </HBox>

                        <TableView fx:id="tablaProductos"
                                   VBox.vgrow="ALWAYS"
                                   prefHeight="390.0"
                                   columnResizePolicy="CONSTRAINED_RESIZE_POLICY"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #e0e6e9;
                                          -fx-border-radius: 6px;">

                            <placeholder>
                                <Label text="No hay productos para mostrar"
                                       style="-fx-font-size: 14px;
                                              -fx-text-fill: #78909c;"/>
                            </placeholder>

                            <columns>

                                <TableColumn fx:id="colId"
                                             text="ID"
                                             prefWidth="65.0"
                                             minWidth="55.0"/>

                                <TableColumn fx:id="colNombre"
                                             text="Nombre"
                                             prefWidth="180.0"
                                             minWidth="130.0"/>

                                <TableColumn fx:id="colTipoProducto"
                                             text="Tipo"
                                             prefWidth="150.0"
                                             minWidth="100.0"/>

                                <TableColumn fx:id="colMarca"
                                             text="Marca"
                                             prefWidth="135.0"
                                             minWidth="90.0"/>

                                <TableColumn fx:id="colCategoria"
                                             text="Categoría"
                                             prefWidth="145.0"
                                             minWidth="100.0"/>

                                <TableColumn fx:id="colPrecio"
                                             text="Precio"
                                             prefWidth="105.0"
                                             minWidth="80.0"/>

                                <TableColumn fx:id="colExistencia"
                                             text="Existencia"
                                             prefWidth="105.0"
                                             minWidth="85.0"/>

                            </columns>
                        </TableView>

                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10.0"
              style="-fx-background-color: #eceff1;
                     -fx-border-color: #d7dde0;
                     -fx-border-width: 1 0 0 0;">

            <padding>
                <Insets top="14.0"
                        right="30.0"
                        bottom="14.0"
                        left="30.0"/>
            </padding>

            <children>
                <Button text="Regresar"
                        onAction="#onRegresar"
                        prefWidth="120.0"
                        prefHeight="38.0"
                        style="-fx-background-color: #c62828;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6px;
                               -fx-cursor: hand;"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>