<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #F5F7FA;">
    <top>
        <VBox spacing="10" style="-fx-padding: 10px;">
            <Label text="📦 Registrar Entrada de Mercancía"
       style="-fx-font-size:22px;
              -fx-font-weight:bold;
              -fx-text-fill:#1565C0;"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="10"
          vgap="10"
          style="-fx-padding:20;
                 -fx-background-color:white;
                 -fx-background-radius:12;">

            <Label text="Clave del producto:"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="txtClave"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

           <Button text="🔍 Buscar"
        onAction="#handleBuscar"
        GridPane.rowIndex="0"
        GridPane.columnIndex="2"
        style="-fx-background-color:#1976D2;
               -fx-text-fill:white;
               -fx-font-weight:bold;
               -fx-background-radius:8;"/>

            <Label text="Nombre:"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <Label fx:id="lblNombre"
                   text="-"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

            <Label text="Existencia actual:"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <Label fx:id="lblExistencia"
                   text="-"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

            <Label text="Cantidad a ingresar:"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="txtCantidad"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="1"/>

        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10"
              alignment="CENTER"
              style="-fx-padding: 10px;">

           <Button text="✔ Registrar"
        onAction="#handleRegistrar"
        style="-fx-background-color:#43A047;
               -fx-text-fill:white;
               -fx-font-weight:bold;
               -fx-background-radius:8;"/>

            <Button text="✖ Cerrar"
        onAction="#handleCerrar"
        style="-fx-background-color:#E53935;
               -fx-text-fill:white;
               -fx-font-weight:bold;
               -fx-background-radius:8;"/>

        </HBox>
    </bottom>

</BorderPane>