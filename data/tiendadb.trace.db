-- ==========================================
-- 3. PRODUCTOS E INVENTARIO (100 Productos Tlapaleros)
-- ==========================================
ASGARD:
DO $$
DECLARE
  v_nombres ARRAY := ARRAY[
    'Martillo de Uña 16oz', 'Desarmador Cruz 1/4x4', 'Desarmador Plano 3/16x4', 'Pinzas de Chofer 8 pulg',
    'Cinta Aislante Negra 18m', 'Llave Stillsen 12 pulg', 'Cinta Canela 48mm', 'Cinta Mágica masking 24mm',
    'Foco LED 10W Luz Blanca', 'Contactos Duplex Blanco', 'Apagador Sencillo', 'Clavija Reforzada Uso Rudo',
    'Cinta Teflón 3/4', 'Tubo PVC Sanitarios 2 pulg x 3m', 'Codo PVC 90 deg 2 pulg', 'Tee PVC Sanitarios 2 pulg',
    'Silicon Multiusos Transparente', 'Resistol 5000 250ml', 'Brocha Pintura 2 pulg', 'Brocha Pintura 4 pulg',
    'Rodillo Felpa 9 pulg', 'Espátula Flexible 3 pulg', 'Lija para Madera Reg 80', 'Lija para Agua Reg 220',
    'Pinza de Corte Diagonal 6 pulg'
  ];
  v_cats ARRAY := ARRAY['HERRAMIENTAS', 'ELÉCTRICO', 'PLOMERÍA', 'PINTURA', 'TORNILLERÍA'];
BEGIN
  FOR i IN 1..100 LOOP
    -- Inventario
    INSERT INTO INVENTARIO (ID_PRODUCTO, EXISTENCIA_ACTUAL, EXISTENCIA_DISPONIBL, STOCK_MINIMO)
    VALUES (i, (i * 3) % 40 + 5, (i * 3) % 40 + 5, 10);

    -- Producto
    INSERT INTO PRODUCTO (
      ID_PRODUCTO, CLAVE, NOMBRE, MARCA, CATEGORIA, TIPO_PRODUCTO, PRECIO, PRECIO_COMPRA, EXISTENCIA_ACTUAL, ID_INVENTARIO
    ) VALUES (
      i, 
      CONCAT('TLAP-', 100 + i), 
      CONCAT(v_nombres[(i % 25) + 1], ' v', i), 
      CASE WHEN i % 2 = 0 THEN 'TRUPER' ELSE 'PRETUL' END, 
      v_cats[(i % 5) + 1], 
      'HARDWARE', 
      35.00 + (i * 2.5), 
      20.00 + (i * 1.8), 
      (i * 3) % 40 + 5, 
      i
    );
  END LOOP;
END $$ [42001-224]
